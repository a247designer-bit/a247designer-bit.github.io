# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Personal AI-harness config/tooling (Impeccable install, editor agent configs) — not site content
.claude/settings.local.json
.claude/skills/
.cursor/
.agents/
.gemini/
.kiro/
.opencode/
.impeccable/

# Source material the deployed app does not read: design-canvas artboards, the
# pre-Next static site, and raw mockup/video exports. ~91MB, kept local only so
# clones and deploys stay small. Nothing under src/ or public/ references these.
/project/
/legacy/
/.design/
